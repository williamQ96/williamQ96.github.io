<div style="
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    color: #333;
    padding: 20px;
    background-color: #f5f5f5;
  ">
    <div
        style="max-width: 600px; margin: auto; background-color: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">

        <!-- Header -->
        <div
            style="border-top: 6px solid #458500; padding: 20px; background-color: #fff; border-bottom: 1px solid #eee;">
            <a style="text-decoration: none; color: #333; font-size: 20px; font-weight: bold;"
                href="https://williamq96.github.io/used-shop/" target="_blank">
                Used Shop @ 24th&Patterson
            </a>
            <div style="float: right; font-size: 14px; color: #666; margin-top: 4px;">
                Order #{{order_id}}
            </div>
        </div>

        <div style="padding: 20px;">
            <p style="margin-top: 0; color: #555;">
                You have received a new order from <strong>{{from_name}}</strong>.
            </p>

            <!-- Note Section -->
            <div
                style="background-color: #f9f9f9; padding: 15px; border-radius: 4px; border: 1px solid #eee; margin-bottom: 20px;">
                <strong style="color: #458500; display: block; margin-bottom: 5px;">Order Note:</strong>
                <span style="font-style: italic;">{{order_note}}</span>
            </div>

            <div style="border-bottom: 2px solid #333; margin-bottom: 10px; padding-bottom: 5px;">
                <strong>Order Details</strong>
            </div>

            <!-- Items Table (Injected HTML) -->
            {{{order_items}}}

            <div style="padding: 24px 0;">
                <div style="border-top: 2px solid #333;"></div>
            </div>

            <!-- Totals -->
            <table style="border-collapse: collapse; width: 100%; text-align: right;">
                <tr>
                    <td style="width: 60%;"></td>
                    <td style="padding: 4px 0; color: #666;">Tax</td>
                    <td style="padding: 4px 0; width: 80px;">$0.00</td>
                </tr>
                <tr>
                    <td style="width: 60%;"></td>
                    <td style="padding: 8px 0; font-size: 16px; font-weight: bold; border-top: 1px solid #eee;">Total
                    </td>
                    <td
                        style="padding: 8px 0; font-size: 16px; font-weight: bold; border-top: 1px solid #eee; color: #458500;">
                        ${{total}}
                    </td>
                </tr>
            </table>

            <div style="margin-top: 30px; text-align: center;">
                <a href="https://williamq96.github.io/used-shop/"
                    style="background-color: #458500; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold;">View
                    Store</a>
            </div>

        </div>
    </div>

    <div style="max-width: 600px; margin: 20px auto; text-align: center; color: #999; font-size: 12px;">
        <p>
            Sent via BizSmart Used Shop System<br />
            Contact: {{from_name}}
        </p>
    </div>
</div>